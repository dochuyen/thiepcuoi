# Copy file này thành .env rồi điền giá trị lấy ở:
# Firebase Console → Project settings (bánh răng) → General → Your apps → Web app → SDK setup and configuration → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ten-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ten-project
VITE_FIREBASE_APP_ID=

# 1 = chạy với Firebase Emulator trên máy (npm run dev:emu), không đụng dữ liệu thật
VITE_USE_EMULATOR=
