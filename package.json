{
  "name": "thiep-cuoi-minimalism-do-dam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "concurrently -k -n emu,web -c yellow,cyan \"firebase emulators:start --only firestore,auth --project demo-thiep\" \"vite --mode emulator\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "firebase-tools": "^13.35.1",
    "vite": "^6.3.5"
  }
}
